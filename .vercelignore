# Keep the Vercel upload + function bundle lean (the Python function has a 250 MB
# unzipped limit). The frontend SOURCE is kept (Vercel builds it); only deps/output
# and things the API never imports are excluded.
.git/
.venv/
venv/
**/__pycache__/
**/*.pyc
.pytest_cache/

# frontend deps + local build (Vercel runs npm install + vite build fresh)
frontend/node_modules/
frontend/dist/
frontend/.vite/

# not imported by the API at runtime
eval/
skills/
app/
notebooks/
design/
scripts/

# large local artifacts / alternate deploy files
outputs/
MEMORY.md
*.docx
*.pdf
Dockerfile
Dockerfile.backend
Dockerfile.backend.dockerignore
docker-compose.yml

# The ROOT requirements.txt is the local/dev set — streamlit, plotly, pytest, uvicorn,
# httpx. Vercel's Python step installs whatever requirements.txt sits at the project
# root, so it pulled 61 packages (588 MB) and blew past the 500 MB function ceiling,
# silently ignoring the lean list this function actually needs. That list lives in
# api/requirements.txt, next to the entrypoint, which is where Vercel looks once this
# one is out of the way.
/requirements.txt
